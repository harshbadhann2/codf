# ─── Copy to apps/web/.env.local for local development ─────────────────────
#
# LOCAL: leave VITE_API_BASE_URL empty. Requests then go to /api and Vite's dev
# proxy forwards them to http://localhost:3030 — no CORS, no configuration.
#
# PRODUCTION (Vercel): set this in Project Settings → Environment Variables to
# your Render URL, with NO trailing slash and NO /api suffix:
#   VITE_API_BASE_URL=https://codf-api.onrender.com
#
# Vite inlines env vars at BUILD time, so changing this in Vercel requires a
# redeploy to take effect.
VITE_API_BASE_URL=

# Optional. Falls back to the value the API reports from /api/health.
VITE_MAX_FILE_SIZE_MB=10
