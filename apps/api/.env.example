# ─── Copy to apps/api/.env for local development ───────────────────────────
# On Render these are set in the dashboard / render.yaml instead.

NODE_ENV=development
PORT=3030
HOST=0.0.0.0

# Comma-separated list of frontend origins allowed to call this API.
# PRODUCTION: this MUST include your Vercel URL, with no trailing slash.
#   CLIENT_ORIGIN=https://codf.vercel.app,https://www.codf.app
# localhost is always allowed, so you can leave this empty in development.
CLIENT_ORIGIN=

# Also allow every https://*.vercel.app preview deployment.
ALLOW_VERCEL_PREVIEWS=false

# Extra origins as regular expressions, comma separated.
CLIENT_ORIGIN_REGEX=

# Number of reverse proxies in front of the app. Render = 1, local = 0.
TRUST_PROXY=1

# ─── Limits ────────────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=10
MAX_CODE_CHARS=300000
PDF_TO_DOCX_MAX_PAGES=60

# How long a converted file stays downloadable (15 minutes).
FILE_TTL_MS=900000
CLEANUP_INTERVAL_MS=300000

# ─── Rate limiting ─────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
CONVERT_RATE_LIMIT_WINDOW_MS=900000
CONVERT_RATE_LIMIT_MAX=60

# ─── Concurrency ───────────────────────────────────────────────────────────
# Keep at 1 on a 512 MB instance: two LibreOffice/PyMuPDF processes will OOM.
MAX_CONCURRENT_JOBS=1
MAX_QUEUED_JOBS=8
JOB_QUEUE_TIMEOUT_MS=60000

# ─── External tools (auto-detected when blank) ─────────────────────────────
# macOS Homebrew: /opt/homebrew/bin/soffice
# Docker image:   /usr/bin/soffice
LIBREOFFICE_PATH=
LIBREOFFICE_TIMEOUT_MS=120000

# Docker image: /opt/venv/bin/python3
PYTHON_PATH=
PDF_TO_DOCX_TIMEOUT_MS=150000

# ─── AI code explanations (optional) ───────────────────────────────────────
# The "Include AI explanation" toggle only works when BOTH are set; with either
# missing, PDFs are generated normally and the UI says the feature is off.
# Never commit a real key — .env is git-ignored.
LLM_API_KEY=your-anthropic-api-key
LLM_MODEL=claude-haiku-4-5

# Code longer than this is not sent for an explanation (not truncated).
LLM_MAX_CODE_CHARS=12000
# Per-attempt timeout; the SDK retries once.
LLM_TIMEOUT_MS=20000

# ─── Optional ──────────────────────────────────────────────────────────────
# Scratch directory for uploads/outputs. Defaults to <tmp>/codf.
WORK_DIR=

# JetBrains Mono ships in assets/fonts; override only for a different font.
CODE_PDF_FONT_REGULAR=
CODE_PDF_FONT_ITALIC=
CODE_PDF_FONT_BOLD=
CODE_PDF_FONT_BOLD_ITALIC=

LOG_LEVEL=info
